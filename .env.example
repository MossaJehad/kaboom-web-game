# Database
DATABASE_URL="postgresql://skyhop:skyhop_dev_password@localhost:5432/skyhop?schema=public"

# Server
NODE_ENV="development"
PORT=3001
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# Security
SESSION_SECRET="replace-with-at-least-32-char-random-secret-key-for-prod"
COOKIE_SECURE="false"
SESSION_TTL_DAYS=14

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional SMTP (leave empty to use local dev email outbox)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SKYHOP Arcade <noreply@skyhop.local>"

# Admin Seed Credentials (override in production)
ADMIN_EMAIL="admin@skyhop.local"
ADMIN_USERNAME="skyadmin"
ADMIN_PASSWORD="ChangeMeAdmin123!"

# Frontend (Vite)
VITE_API_URL="http://localhost:3001"
